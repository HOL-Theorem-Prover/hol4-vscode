{
    "name": "hol4-vscode",
    "displayName": "HOL4 + LSP mode",
    "description": "A VSCode extension for interacting with the HOL4 theorem prover",
    "version": "0.3.3",
    "icon" : "resources/icon.png",
    "repository": "https://github.com/HOL-Theorem-Prover/hol4-vscode",
    "engines": {
        "vscode": "^1.75.0"
    },
    "publisher": "HOL4Developers",
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:hol4"
    ],
    "license" : "BSD-3-Clause",
    "main": "./out/extension.js",
    "contributes": {
        "grammars": [
            {
                "language": "hol4",
                "scopeName": "source.hol4",
                "path": "./hol4-grammar.json"
            }
        ],
        "languages": [
            {
                "id": "hol4",
                "extensions": [
                    ".sig",
                    ".sml"
                ],
                "aliases": [
                    "HOL4"
                ],
                "configuration": "./hol4-language.json",
                "filenamePatterns": [
                    "*Script.sml"
                ]
            }
        ],
        "commands": [
            {
                "command": "hol4-mode.startSession",
                "title": "Start session",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.stopSession",
                "title": "Stop session",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.interrupt",
                "title": "Interrupt HOL process",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.input.convert",
                "title": "Input: Convert Current Abbreviation",
                "description": "Converts the current abbreviation (e.g. \\lam).",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendSelection",
                "title": "Send selection",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendUntilCursor",
                "title": "Send all up to current line",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.holmake",
                "title": "Run Holmake in the directory of the current document",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.toggleShowAssums",
                "title": "Toggle printing of theorem hypotheses",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.toggleShowTypes",
                "title": "Toggle printing of term types",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.clearAll",
                "title": "Clear history",
                "icon": "$(close)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.restart",
                "title": "Restart session",
                "icon": {
                    "light": "resources/light/interrupt.svg",
                    "dark": "resources/dark/interrupt.svg"
                },
                "category": "HOL"
            },
            {
                "command": "hol4-mode.expandAllCells",
                "title": "Expand all cells",
                "icon": "$(expand-all)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.collapseAllCells",
                "title": "Collapse all cells",
                "icon": "$(collapse-all)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.toggleGoalsPane",
                "title": "Toggle HOL Goals pane",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.restart",
                "title": "Restart LSP server for the active script",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.showOutput",
                "title": "Show LSP output channel for the active script",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.retryCompile",
                "title": "Compile the active script again",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.gotoOutstandingProof",
                "title": "Go to the next unchecked proof",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.search",
                "title": "Search for theorems",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.evalSelection",
                "title": "Evaluate selection",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.showEvalOutput",
                "title": "Show evaluation output for the active script",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.input.smartQuote",
                "title": "Input: Insert a HOL quotation",
                "description": "Inserts ‘’, or turns an empty ‘’ into “”.",
                "category": "HOL"
            }
        ],
        "keybindings": [
            {
                "command": "hol4-mode.input.convert",
                "key": "tab",
                "when": "editorTextFocus && hol4-mode.input.isActive"
            },
            {
                "command": "hol4-mode.input.smartQuote",
                "key": "`",
                "when": "editorTextFocus && !editorReadonly && editorLangId == hol4"
            },
            {
                "command": "hol4-mode.startSession",
                "key": "ctrl+h h",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.stopSession",
                "key": "ctrl+h ctrl+x",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.interrupt",
                "key": "ctrl+h ctrl+c",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.sendSelection",
                "key": "ctrl+h s",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendUntilCursor",
                "key": "ctrl+h ctrl+shift+s",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.toggleShowTypes",
                "key": "ctrl+h ctrl+t",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.toggleShowAssums",
                "key": "ctrl+h ctrl+a",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.lsp.toggleGoalsPane",
                "key": "ctrl+h ctrl+g",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.lsp.search",
                "key": "ctrl+h ctrl+shift+m",
                "when": "editorLangId == hol4 || activeWebviewPanelId == 'hol4.goalsPane'"
            },
            {
                "command": "hol4-mode.lsp.evalSelection",
                "key": "ctrl+h ctrl+e",
                "when": "editorLangId == hol4"
            }
        ],
        "menus": {
            "interactive/toolbar": [
                {
                    "command": "hol4-mode.clearAll",
                    "group": "navigation@0",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.restart",
                    "group": "navigation@1",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.expandAllCells",
                    "group": "navigation@2",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.collapseAllCells",
                    "group": "navigation@3",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                }
            ]
        },
        "configuration": {
            "title": "HOL4",
            "properties": {
                "hol4-mode.rawMessages": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show raw input/output in console view"
                },
                "hol4-mode.holdir": {
                    "type": "string",
                    "description": "Set HOL installation directory"
                },
                "hol4-mode.input.leader": {
                    "type": "string",
                    "default": "\\",
                    "maxLength": 1,
                    "description": "Character that begins a Unicode abbreviation. Typing it starts an abbreviation, shown underlined until it resolves: `\\alpha` gives α, `\\r` gives ⇒. Type it twice for the character itself. Hover over any Unicode character in a HOL script to be told how to type it."
                },
                "hol4-mode.eagerReplacement": {
                    "type": "boolean",
                    "default": true,
                    "description": "Replace a leader abbreviation as soon as it can only mean one thing, rather than waiting for Tab or for the cursor to leave it."
                },
                "hol4-mode.input.leaderless": {
                    "type": "boolean",
                    "default": true,
                    "description": "Rewrite HOL's ASCII operators to Unicode as you type them, with no leader: `/\\` gives ∧, `==>` gives ⇒, `!` gives ∀. These are the eleven rules of the Emacs `hol-input` method. They fire only inside HOL terms, never in the surrounding SML, in string literals, or in a `Quote` block. `!!` gives a literal `!` and `??` a literal `?`; for anything else, undo immediately after a rewrite restores what you typed."
                },
                "hol4-mode.input.rules": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "markdownDescription": "Extra leaderless rewrites, merged over the built-in ones: a key is the ASCII you type, the value what replaces it, and `null` removes a built-in rule. Longest match wins, so adding a rule whose key extends a built-in one (`==` beside `==>`) makes the shorter one wait a keystroke before it settles. Use `$CURSOR` in a value to say where the cursor should land.\n\nExample: `{ \"IN\": \"∈\", \"SUBSET\": \"⊆\" }`"
                },
                "hol4-mode.input.smartQuotes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Make the backtick key insert HOL's Unicode quotation delimiters: one press gives the pair ‘’ with the cursor between them, a second turns an empty pair into “”, and a press on a closing delimiter steps over it. On an existing quotation's opening delimiter it retypes the whole quotation as the other kind, and with text selected it wraps the selection. Turn this off to type literal backticks."
                },
                "hol4-mode.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable the HOL4 LSP client. One `bin/hol lsp` process is started per visible `*Script.sml` file, and stopped when the file is closed. Diagnostics, hover, and the HOL Goals pane require this."
                },
                "hol4-mode.lsp.checkProofs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check the proofs in a script, rather than taking them on trust. Elaboration does not run tactics, which is what makes it fast; with this on, a worker pool replays each proof and reports one that fails as an error on the theorem's name, and one that suspends or diverges as a warning. It costs what the proofs cost: one worker per processor, capped at eight. Changing it takes effect without a restart."
                },
                "hol4-mode.lsp.openGoalsOnStartup": {
                    "type": "boolean",
                    "default": true,
                    "description": "Open the HOL Goals pane as soon as a HOL script is opened, rather than waiting for `HOL: Toggle the goals pane`. The pane opens beside the editor without taking focus."
                },
                "hol4-mode.lsp.hoverWidth": {
                    "type": "number",
                    "default": 50,
                    "minimum": 20,
                    "maximum": 500,
                    "description": "Column width the language server renders hover text at, including theorem statements. VS Code does not expose the width of a hover box, so this is an estimate rather than a measurement; 50 is about what a default hover box holds. Too narrow only costs extra line breaks, while too wide makes the box scroll sideways, so err low. Raise it if you have a small font or a wide box."
                },
                "hol4-lsp.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "compact",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Record the JSON-RPC traffic between VS Code and each `bin/hol lsp` process in the matching `HOL4 LSP Trace: <file>` output channel. `messages` names each request and notification; `verbose` adds their parameters and results. For diagnosing a server that misbehaves only under VS Code: the transcript shows what was asked and in what order, which no server-side log can. Takes effect without a restart. Leave it off otherwise, as it is a lot of output."
                },
                "hol4-mode.lsp.executable": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to `bin/hol` for the LSP servers. Empty falls back to `hol4-mode.holdir/bin/hol`, then `$HOLDIR/bin/hol`."
                }
            }
        },
        "configurationDefaults": {
            "files.associations": {
                "*.smd": "markdown"
            },
            "[hol4]": {
                "editor.acceptSuggestionOnEnter": "off",
                "editor.unicodeHighlight.ambiguousCharacters": false,
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "files.encoding": "utf8"
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:offline": "npm run compile && node test/offline/grammar.js && node test/offline/hol-input.js && node test/offline/leaderless-input.js && node test/offline/goal-segments.js && node test/offline/goals-error-banner.js && node test/offline/lsp-client.js && node test/offline/proof-tally.js"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^9.0.0",
        "@types/node": "^20.0",
        "@types/vscode": "^1.63.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "@vscode/test-electron": "^2.0.3",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^9.32.0",
        "glob": "^11.0.0",
        "mocha": "^9.1.3",
        "typescript": "^4.5.4"
    }
}
